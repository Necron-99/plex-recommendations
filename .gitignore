# Plex Recommendations - Git Ignore File
# This ensures no sensitive data or temporary files are committed

# ===========================================
# SENSITIVE DATA - NEVER COMMIT
# ===========================================

# Plex backup files and databases
backups/
*.db
*.db-*
*.db-wal
*.db-shm
*bilbo*
*azog*
*plex-backup*
*plex-db*

# API keys and credentials
.env
.env.local
.env.production
config.json
secrets.json
credentials.json

# AWS credentials
.aws/
aws-credentials.json

# Plex tokens and server info
plex-token.txt
plex-server.txt
plex-config.json

# ===========================================
# TEMPORARY FILES
# ===========================================

# JSON response files
*.json
!package*.json
!tsconfig*.json
!*.config.json

# Temporary files
temp-*
*-temp.*
*.tmp
*.temp

# Response files
response.json
*-response.json
temp-response.json

# Data export files
current-plex-data-*
blended-plex-data-*
plex-export-*
enhanced-plex-history-*
watch-history-*

# ===========================================
# DEPLOYMENT FILES
# ===========================================

# Deployment archives
*.tar.gz
*.zip
plex-recommendations-*.tar.gz

# Local deployment directories
plex-recommendations/
s3-deployment/

# ===========================================
# SYSTEM FILES
# ===========================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
*.lnk

# Linux
*~

# ===========================================
# DEVELOPMENT FILES
# ===========================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# ===========================================
# LOGS
# ===========================================

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================================
# SECURITY NOTES
# ===========================================

# Remember: Never commit:
# - Plex database files
# - API keys or tokens
# - AWS credentials
# - Personal data
# - Backup files
# - Temporary response files