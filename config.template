# Plex Movie Recommendations - Configuration Template
# Copy this file to config.py and fill in your actual values

# Plex Configuration
PLEX_SERVER = "your-plex-server:32400"
PLEX_TOKEN = "your_plex_token_here"

# AWS Configuration
AWS_REGION = "us-east-1"
S3_BUCKET = "your-s3-bucket-name"
AWS_PROFILE = "default"

# TMDB API Configuration
TMDB_API_KEY = "your_tmdb_api_key_here"

# Lambda Configuration
LAMBDA_ROLE_ARN = "arn:aws:iam::YOUR_ACCOUNT_ID:role/YOUR_LAMBDA_ROLE"
LAMBDA_FUNCTION_NAME = "your-plex-analyzer-function"

# Instructions:
# 1. Get your Plex token from: https://support.plex.tv/articles/204059436/
# 2. Get your TMDB API key from: https://www.themoviedb.org/settings/api
# 3. Create an S3 bucket for storing your Plex data
# 4. Set up AWS credentials and IAM roles for Lambda execution
